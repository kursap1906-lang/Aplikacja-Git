{
  "name": "copilot-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test src/app.test.ts src/ai/openai.test.ts src/ai/team-analysis.test.ts src/github/copilot-provider.test.ts src/projects/project-scanner.test.ts src/security/passwords.test.ts src/security/secrets.test.ts src/stages/stage-machine.test.ts src/workspace/hierarchy.test.ts src/workspace/team-execution.test.ts",
    "test:workspace": "node --experimental-strip-types --test src/workspace/workspace.integration.test.ts src/workspace/team-execution.integration.test.ts src/ai/budget.integration.test.ts sdk-worker/src/metadata.integration.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  }
}
